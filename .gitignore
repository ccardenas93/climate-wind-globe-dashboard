@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  color-scheme: dark;
  --bg: #050b14;
  --bg-2: #0b1424;
  --panel: rgba(8, 18, 33, 0.88);
  --panel-strong: rgba(14, 24, 42, 0.98);
  --border: rgba(148, 163, 184, 0.18);
  --text: #e5eefb;
  --muted: #9eb7d2;
  --cyan: #67e8f9;
  --purple: #c084fc;
  --amber: #fbbf24;
  --danger: #f87171;
  --success: #4ade80;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top, rgba(59, 130, 246, 0.22), transparent 25%),
    linear-gradient(135deg, var(--bg) 0%, #07121d 30%, #050b14 100%);
  color: var(--text);
}

button, input {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 420px minmax(0, 1fr);
  gap: 20px;
  padding: 24px;
}

.panel,
.globe-panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 24px;
  box-shadow: 0 20px 50px rgba(2, 6, 23, 0.5);
  backdrop-filter: blur(10px);
}

.left-panel {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(103, 232, 249, 0.2), rgba(192, 132, 252, 0.2));
  border: 1px solid rgba(103, 232, 249, 0.3);
  color: var(--cyan);
  font-size: 1.2rem;
}

.eyebrow {
  margin: 0 0 4px;
  font-size: 0.7rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}

h1, h2, h3, p {
  margin: 0;
}

h1 {
  font-size: clamp(1.7rem, 2vw, 2.2rem);
}

.search-box {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.search-box label {
  font-size: 0.8rem;
  color: var(--muted);
}

.search-row {
  display: flex;
  gap: 8px;
}

.search-row input {
  flex: 1;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 12px;
  padding: 12px 14px;
  outline: none;
}

.search-row button {
  border: none;
  background: linear-gradient(135deg, var(--cyan), var(--purple));
  color: #03111b;
  font-weight: 700;
  border-radius: 12px;
  padding: 0 16px;
  cursor: pointer;
}

.suggestions {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 4px;
}

.suggestions button {
  width: 100%;
  text-align: left;
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 10px;
  padding: 10px 12px;
  cursor: pointer;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.suggestions button:hover {
  border-color: rgba(103, 232, 249, 0.5);
  transform: translateY(-1px);
}

.status-card,
.forecast-card {
  background: rgba(15, 23, 42, 0.55);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.status-header h2 {
  font-size: 1.6rem;
}

.weather-badge {
  font-size: 0.75rem;
  border-radius: 999px;
  border: 1px solid rgba(103, 232, 249, 0.35);
  background: rgba(103, 232, 249, 0.1);
  color: var(--cyan);
  padding: 7px 10px;
}

.temperature-row {
  display: flex;
  align-items: end;
  gap: 10px;
  margin-top: 18px;
}

.temperature {
  font-size: 3.3rem;
  font-weight: 800;
  line-height: 1;
}

.temperature-meta {
  color: var(--muted);
  padding-bottom: 8px;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-top: 24px;
}

.stat-grid div {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 14px 12px;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  background: rgba(15, 23, 42, 0.5);
}

.stat-grid span {
  color: var(--muted);
  font-size: 0.76rem;
}

.stat-grid strong {
  font-size: 1.04rem;
}

.loading-message,
.error-message {
  min-height: 90px;
  display: flex;
  align-items: center;
  color: var(--muted);
}

.error-message {
  color: var(--danger);
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: center;
  margin-bottom: 12px;
}

.section-title-row h3 {
  font-size: 1.1rem;
}

.section-title-row span {
  color: var(--muted);
  font-size: 0.8rem;
}

.forecast-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.forecast-item {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 10px;
  background: rgba(15, 23, 42, 0.48);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 12px;
  padding: 10px 12px;
  color: var(--muted);
}

.forecast-item strong {
  font-size: 1.2rem;
}

.forecast-item span:last-child {
  justify-self: end;
  color: var(--text);
}

.globe-panel {
  padding: 18px 18px 14px;
  display: flex;
  flex-direction: column;
  min-height: 780px;
}

.map-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 6px 8px 18px;
}

.map-header h2 {
  font-size: clamp(1.5rem, 2vw, 2rem);
}

.header-badges {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.header-badges span {
  font-size: 0.74rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--cyan);
  border: 1px solid rgba(103, 232, 249, 0.38);
  background: rgba(103, 232, 249, 0.08);
  border-radius: 999px;
  padding: 8px 10px;
}

.globe-shell {
  position: relative;
  flex: 1;
  min-height: 560px;
  border-radius: 22px;
  overflow: hidden;
  background: radial-gradient(circle at center, rgba(14, 116, 144, 0.2), rgba(2, 6, 23, 0.9));
  border: 1px solid rgba(148, 163, 184, 0.14);
}

.metrics-bar {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 16px;
}

.metrics-bar > div {
  background: rgba(15, 23, 42, 0.62);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 13px 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.metrics-bar span {
  color: var(--muted);
  font-size: 0.74rem;
}

.metrics-bar strong {
  font-size: 1rem;
}

@media (max-width: 980px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .globe-panel {
    min-height: 620px;
  }
}

@media (max-width: 640px) {
  .app-shell {
    padding: 16px;
  }

  .left-panel,
  .globe-panel {
    border-radius: 18px;
  }

  .search-row {
    flex-direction: column;
  }

  .metrics-bar {
    grid-template-columns: 1fr;
  }

  .temperature {
    font-size: 2.5rem;
  }
}
